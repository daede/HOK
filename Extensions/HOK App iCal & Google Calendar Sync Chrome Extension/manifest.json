{
  "manifest_version": 3,
  "name": "HOK App iCal & Google Calendar Sync",
  "version": "1.1",
  "description": "Exportiert und synchronisiert den Vorlesungsplan der HOK App via GitHub mit Google Kalender.",
  "icons": {
    "16": "images/HOK-App-iCal-&-Google-Calendar-Sync-Chrome-Extension-16px.png",
    "32": "images/HOK-App-iCal-&-Google-Calendar-Sync-Chrome-Extension-32px.png",
    "48": "images/HOK-App-iCal-&-Google-Calendar-Sync-Chrome-Extension-48px.png",
    "128": "images/HOK-App-iCal-&-Google-Calendar-Sync-Chrome-Extension-128px.png"
  },
  "action": {
    "default_icon": {
      "16": "images/HOK-App-iCal-&-Google-Calendar-Sync-Chrome-Extension-16px.png",
      "32": "images/HOK-App-iCal-&-Google-Calendar-Sync-Chrome-Extension-32px.png",
      "48": "images/HOK-App-iCal-&-Google-Calendar-Sync-Chrome-Extension-48px.png",
      "128": "images/HOK-App-iCal-&-Google-Calendar-Sync-Chrome-Extension-128px.png"
    }
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://app.hok.ac.at/*"],
      "js": ["content.js"]
    }
  ]
}