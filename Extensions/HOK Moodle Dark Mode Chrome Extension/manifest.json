{
  "manifest_version": 3,
  "name": "HOK WebLearn Dark Mode",
  "version": "1.0",
  "description": "Custom dark mode theme and inverted logo for HOK WebLearn.",
  "icons": {
    "16": "images/HOK-Moodle-Dark-Mode-Chrome-Extension-16px.png",
    "32": "images/HOK-Moodle-Dark-Mode-Chrome-Extension-32px.png",
    "48": "images/HOK-Moodle-Dark-Mode-Chrome-Extension-48px.png",
    "128": "images/HOK-Moodle-Dark-Mode-Chrome-Extension-128px.png"
  },
  "action": {
    "default_icon": {
      "16": "images/HOK-Moodle-Dark-Mode-Chrome-Extension-16px.png",
      "32": "images/HOK-Moodle-Dark-Mode-Chrome-Extension-32px.png",
      "48": "images/HOK-Moodle-Dark-Mode-Chrome-Extension-48px.png",
      "128": "images/HOK-Moodle-Dark-Mode-Chrome-Extension-128px.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://weblearn.fh-kufstein.ac.at/*",
        "https://weblearn.hok.ac.at/*"
      ],
      "css": [
        "darkmode.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "images/hok-logo-inverted.png"
      ],
      "matches": [
        "https://weblearn.fh-kufstein.ac.at/*",
        "https://weblearn.hok.ac.at/*"
      ]
    }
  ]
}